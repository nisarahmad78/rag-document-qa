# Copy this file to .env and fill in your values.
# The app runs without an LLM key (retrieval still works), but answers
# are only generated when OPENAI_API_KEY is set.

# Any OpenAI-compatible API works: OpenAI, Azure OpenAI, Ollama, LM Studio, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional overrides
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=data/chroma
DATA_DIR=data
